# Lifecycle scripts are OFF for every install under tools/ui.
#
# A dependency's install script runs code from the registry on this machine at
# install time, which is the shortest path a compromised package has to a
# developer's shell. Nothing here needs one: the browser the rendered grader
# drives is the container's own, not a copy Playwright downloads, which is why
# tools/ui-render-run.sh documents the install with
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1.
#
# This file is the enforcement. The flag in that header comment is a human
# remembering; this setting is not, and `pnpm install` typed here with no flags
# runs no dependency script.
#
# To turn them back on, set this to false and put the reason on the comment
# line directly above the setting. tools/pinning-check.sh refuses a `false`
# that carries no reason, so the reason is committed or the build stops.
ignore-scripts = true
