# WRONG ON PURPOSE. Lifecycle scripts are back on and nothing here says why, so
# a later reader cannot tell this from a mistake. P4 allows the opt-back-in and
# requires the reason beside it; tools/pinning-check.sh requires this tree to go
# red naming P4.
#
# The comment block above sits DIRECTLY on top of the setting, with no blank
# line between them, and it is still not a reason. That is the point of this
# tree: an earlier version of the check accepted any adjacent comment and this
# file passed it, on the strength of its own instructions. A reason has to be
# marked as one.
ignore-scripts = false
