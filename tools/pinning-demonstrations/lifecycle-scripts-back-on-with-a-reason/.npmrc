# RIGHT ON PURPOSE, and the only tree here that is. P4 does not forbid turning
# lifecycle scripts back on; it requires a committed reason when you do. This is
# what that looks like, and tools/pinning-check.sh requires this tree to pass.
#
# Without this demonstration, "the check refuses a `false` with no reason" and
# "the check refuses every `false`" would produce the same evidence, and the
# escape hatch P4 deliberately leaves open would be shut by accident.
# reason: this package builds a native addon in its postinstall step and ships no prebuilt binary
ignore-scripts = false
