# Canonical input for the report_short_audio_descriptor_lpcm CEC vector: LPCM, 2 channels, 48 kHz, 16 bit: the only descriptor the hub reports.
#
# Format: one "key = value" per line, '#' starts a comment. opcode is the name
# crates/cec/src/codec.rs gives it (empty for a poll); operands are hex with no separators;
# validity is what crates/cec/src/validate.rs must say of the message.

initiator = 5
destination = 0
opcode = report_short_audio_descriptor
operands = 090401
validity = ok
