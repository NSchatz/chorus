# chorus CEC golden vector: only an Audio System sends it.
#
# Committed, never written by a test. Rust-only by declaration (CEC runs on the Linux hub
# alone): crates/cec/tests/fixtures.rs decodes these bytes to set_system_audio_mode_from_tv.fields and encodes the
# fields back to these bytes. Format: whitespace separated hex bytes, '#' starts a comment.

# header: initiator 0, destination 5
05

# opcode: set_system_audio_mode
72

# operands
00
