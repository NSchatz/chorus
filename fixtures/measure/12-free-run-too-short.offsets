# Relative offset observations between two clients running with correction
# disabled, generated from 12-free-run-too-short.params. Every timestamp is nanoseconds from a monotonic
# source, which is what docs/protocol.md requires of every timestamp this project
# moves; a settable clock here would put a step in a straight line and be read as
# drift.
#
# Format: key = value, then [observations], then one 't_ns offset_ns' pair per line.

label = free-run-too-short
declared_rate_ppm = 37.5
declared_jitter_us = 0

[observations]
0 0
1000000000 37500
2000000000 75000
3000000000 112500
4000000000 150000
5000000000 187500
6000000000 225000
7000000000 262500
8000000000 300000
9000000000 337500
10000000000 375000
11000000000 412500
12000000000 450000
13000000000 487500
14000000000 525000
15000000000 562500
16000000000 600000
17000000000 637500
18000000000 675000
19000000000 712500
20000000000 750000
