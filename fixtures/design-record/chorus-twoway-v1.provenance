# Where chorus-twoway-v1.json came from: the active two-way's crossover
# (docs/hardware/twoway-speaker.md, version 1), one LR4 at 2000 Hz for 48 kHz between its woofer
# and its tweeter. The record is committed as it was exported, byte for byte:
# crates/dsp/tests/design_record.rs holds the file to the sha256 below (and to the same digest
# written in the test), so an edit by hand fails the test. To refresh it: fixtures/README.md,
# "design-record/".
#
# The command is the call the acoustics package's README documents for writing a record, run with
# the package installed from the release tag (uv, rootless). The package and its module are
# written as placeholders: the library is the owner's and is not named here.

record = chorus-twoway-v1.json
source = the acoustics package of the owner's shared Python library
release = v1.49.0
command = uv run --package <the acoustics package> python -c "from <its module> import *; write_record(design_record('chorus-twoway-v1', [linkwitz_riley(48000, 2000)], response_hz=(250, 500, 1000, 2000, 4000, 8000, 16000)), 'chorus-twoway-v1.json')"
exported = 2026-10-06
schema = speaker-design-record
version = 1
sha256 = b2dbe5805ce21b43ebc7404f4f627c78020bb3a7a5c8613f6ed7235218e0dcf5
