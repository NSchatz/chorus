# Canonical input for the catalog v2 error-bass-management-polarity vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-bass-management-polarity.json. Nothing of it is applied.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.
#
# A polarity is "normal" or "inverted".

message_type = error
zones = living,kitchen
input = {"v":2,"t":"bass_management","zone":"living","sub_polarity":"reversed"}
field = sub_polarity
ends_the_session = 0
