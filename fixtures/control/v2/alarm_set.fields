# Canonical input for the catalog v2 alarm_set vector.
#
# Encoding these field values must produce exactly alarm_set.json, and decoding
# alarm_set.json must recover exactly these field values.
#
# Configuration only: firing, ramping and stopping are the server runtime's.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = alarm_set
alarm = wake
target = bedroom
time = 06:45
days = mon,tue,wed,thu,fri
source = chime:bell
volume = 0.300
ramp_s = 30
duration_min = 60
enabled = 1
