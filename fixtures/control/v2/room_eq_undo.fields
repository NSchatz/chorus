# Canonical input for the catalog v2 room_eq_undo vector.
#
# Encoding these field values must produce exactly room_eq_undo.json, and decoding
# room_eq_undo.json must recover exactly these field values.
#
# (room correction, ADR 0000) Put the room's correction back as it was before the last room_eq that carried filters.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = room_eq_undo
zone = living
