# Canonical input for the catalog v2 error-group-save-room-id vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-group-save-room-id.json. Nothing of it is applied.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen,study
input = {"v":2,"t":"group_save","group":"kitchen","name":"Kitchen","zones":["kitchen","study"]}
field = group
ends_the_session = 0
