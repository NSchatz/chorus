# Canonical input for the catalog v2 join vector.
#
# Encoding these field values must produce exactly join.json, and decoding
# join.json must recover exactly these field values.
#
# A room joins the group another room (or a group) is in. Joining a room that
# is alone forms a live group whose id the server assigns.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = join
zone = kitchen
target = study
