# Canonical input for the catalog v2 error-sound-treble-not-whole vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-sound-treble-not-whole.json. Nothing of it is applied.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.
#
# Tone is whole dB steps.

message_type = error
zones = living,kitchen
input = {"v":2,"t":"sound","zone":"living","treble":1.5}
field = treble
ends_the_session = 0
