# Canonical input for the catalog v2 error-announce-no-origin vector.
#
# `input` is refused, by the decoder or by the room state the lines below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-announce-no-origin.json. Nothing of it is applied.
#
# (goal 18) An announcement on a server started with no `--announce-origin`: every one is refused, by name.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen
input = {"v":2,"t":"announce","target":"kitchen","url":"http://ha.example:8123/api/tts_proxy/abc.mp3"}
field = url
ends_the_session = 0
