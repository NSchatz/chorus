# Canonical input for the catalog v2 sound-partial vector.
#
# Encoding these field values must produce exactly sound-partial.json, and decoding
# sound-partial.json must recover exactly these field values.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.
#
# A partial update: only night mode changes; every absent field keeps what
# the room had.

message_type = sound
zone = kitchen
night = 1
