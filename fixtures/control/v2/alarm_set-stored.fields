# Canonical input for the catalog v2 alarm_set-stored vector.
#
# Encoding these field values must produce exactly alarm_set-stored.json, and decoding
# alarm_set-stored.json must recover exactly these field values.
#
# (goal 17) An alarm whose source is a stored source.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = alarm_set
alarm = radio
target = bedroom
time = 06:45
days = mon,tue,wed,thu,fri
source = stored:morning-radio
volume = 0.300
ramp_s = 30
duration_min = 60
enabled = 1
