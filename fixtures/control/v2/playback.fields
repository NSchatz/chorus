# Canonical input for the catalog v2 playback vector.
#
# Encoding these field values must produce exactly playback.json, and decoding
# playback.json must recover exactly these field values.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.
#
# Goal 17: pause, resume or skip what the Spotify receiver of a target's group plays.

message_type = playback
target = kitchen
action = pause
