# Canonical input for the catalog v2 error-announce-target vector.
#
# `input` is refused, by the decoder or by the room state the lines below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-announce-target.json. Nothing of it is applied.
#
# (goal 18) An announcement for a target that is no room and no group.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen
announce_origins = http://ha.example:8123
input = {"v":2,"t":"announce","target":"garage","url":"http://ha.example:8123/api/tts_proxy/abc.mp3"}
field = target
ends_the_session = 0
