# Canonical input for the catalog v2 error-input-label-role vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-input-label-role.json. Nothing of it is applied.
#
# (goal 17) An input's role is 'line-in' or 'streamer'; there is no microphone
# role (brief section 4.8).
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen
input = {"v":2,"t":"input_label","input":"endpoint-c/line-1","name":"Mic","role":"microphone"}
field = role
ends_the_session = 0
