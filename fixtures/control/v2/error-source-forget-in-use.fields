# Canonical input for the catalog v2 error-source-forget-in-use vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-source-forget-in-use.json. Nothing of it is applied.
#
# (goal 17) A stored source an alarm plays is not forgotten from under it.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = bedroom
command.0 = {"v":2,"t":"source_store","id":"morning-radio","kind":"url","value":"https://radio.example/stream.mp3","name":"Morning radio"}
command.1 = {"v":2,"t":"alarm_set","alarm":"radio","target":"bedroom","time":"06:45","days":[],"source":"stored:morning-radio","volume":0.300,"ramp_s":30,"duration_min":60,"enabled":true}
input = {"v":2,"t":"source_forget","id":"morning-radio"}
field = id
ends_the_session = 0
