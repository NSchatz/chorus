# Canonical input for the catalog v2 alarm_stop vector.
#
# Encoding these field values must produce exactly alarm_stop.json, and decoding
# alarm_stop.json must recover exactly these field values.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = alarm_stop
alarm = wake
