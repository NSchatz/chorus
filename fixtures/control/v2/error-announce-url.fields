# Canonical input for the catalog v2 error-announce-url vector.
#
# `input` is refused, by the decoder or by the room state the lines below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-announce-url.json. Nothing of it is applied.
#
# (goal 18) An announcement whose URL is not http or https: refused by the decoder, under the shape rules a stored `url` source has.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen
announce_origins = http://ha.example:8123
input = {"v":2,"t":"announce","target":"kitchen","url":"file:///etc/hostname"}
field = url
ends_the_session = 0
