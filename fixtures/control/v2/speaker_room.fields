# Canonical input for the catalog v2 speaker_room vector.
#
# Encoding these field values must produce exactly speaker_room.json, and decoding
# speaker_room.json must recover exactly these field values.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.
#
# Goal 14: an adopted speaker is assigned a room; it becomes a member of it
# and leaves every other.

message_type = speaker_room
speaker = chorus-0123456789ab
room = kitchen
