# Canonical input for the catalog v2 error-source-store-spotify vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-source-store-spotify.json. Nothing of it is applied.
#
# (goal 17) A stored Spotify value is a Spotify URI, not a web link.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen
input = {"v":2,"t":"source_store","id":"wake","kind":"spotify","value":"https://open.spotify.example/playlist/abc","name":"Wake"}
field = value
ends_the_session = 0
