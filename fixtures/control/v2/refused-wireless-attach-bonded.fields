# Canonical input for the catalog v2 refused-wireless-attach-bonded vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly refused-wireless-attach-bonded.json. Nothing of it is applied.
#
# An endpoint already in a bonded set that reports a link other than wired is
# refused, so the set never holds one (K91).
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = living
command.0 = {"v":2,"t":"attach","zone":"living","endpoint":"endpoint-a","link":"wired"}
command.1 = {"v":2,"t":"attach","zone":"living","endpoint":"endpoint-b","link":"wired"}
command.2 = {"v":2,"t":"bond","zone":"living","members":[{"endpoint":"endpoint-a","role":"FL"},{"endpoint":"endpoint-b","role":"FR"}]}
input = {"v":2,"t":"attach","zone":"living","endpoint":"endpoint-b","link":"wireless"}
field = link
ends_the_session = 0
