# Canonical input for the catalog v2 refused-wireless-bond vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly refused-wireless-bond.json. Nothing of it is applied.
#
# K91: an endpoint whose link is wireless is refused from any bonded set, and
# the refusal names the field and the endpoint.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = living
command.0 = {"v":2,"t":"attach","zone":"living","endpoint":"endpoint-a","link":"wired"}
command.1 = {"v":2,"t":"attach","zone":"living","endpoint":"endpoint-b","link":"wireless"}
input = {"v":2,"t":"bond","zone":"living","members":[{"endpoint":"endpoint-a","role":"FL"},{"endpoint":"endpoint-b","role":"FR"}]}
field = members
ends_the_session = 0
