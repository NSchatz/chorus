# Canonical input for the catalog v2 error-playback-action vector.
#
# `input` is refused, by the decoder or by the room state the lines below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-playback-action.json. Nothing of it is applied.
#
# (goal 17) A playback action the catalog does not declare.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen
input = {"v":2,"t":"playback","target":"kitchen","action":"stop"}
field = action
ends_the_session = 0
