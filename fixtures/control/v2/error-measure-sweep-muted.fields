# Canonical input for the catalog v2 error-measure-sweep-muted vector.
#
# `input` is refused, by the decoder or by the room state the lines below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-measure-sweep-muted.json. Nothing of it is applied.
#
# (room correction, ADR 0000) A sweep for a muted room, where it would be silence.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen
command.0 = {"v":1,"t":"attach","zone":"kitchen","endpoint":"endpoint-a"}
command.1 = {"v":1,"t":"mute","zone":"kitchen","muted":true}
input = {"v":2,"t":"measure_sweep","zone":"kitchen"}
field = zone
ends_the_session = 0
