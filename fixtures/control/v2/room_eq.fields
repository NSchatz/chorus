# Canonical input for the catalog v2 room_eq vector.
#
# Encoding these field values must produce exactly room_eq.json, and decoding
# room_eq.json must recover exactly these field values.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.
#
# Two correction filters, each `freq_hz gain_db q` here and an object on
# the wire, inside the room-correction bounds (20 to 1000 Hz, -12.00 to
# 3.00 dB, Q 0.500 to 10.000), and enabled.

message_type = room_eq
zone = living
filters = 42 -6.00 4.500; 120 -3.25 2.000
enabled = 1
