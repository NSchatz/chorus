# Canonical input for the catalog v2 error-speaker-room-bonded vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones (and, for the speakers, the
# ids `adopted.N` says the session layer adopted, each with its key's
# fingerprint), and encoding the refusal must produce exactly
# error-speaker-room-bonded.json. Nothing of it is applied.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.
#
# A speaker that plays in a room's bonded set is not moved out from under it:
# the owner unbonds the room first.

message_type = error
zones = living,kitchen
adopted.0 = chorus-0123456789ab 1f0e:2d3c:4b5a:6978
command.0 = {"v":2,"t":"attach","zone":"living","endpoint":"chorus-0123456789ab","link":"wired"}
command.1 = {"v":2,"t":"attach","zone":"living","endpoint":"endpoint-b","link":"wired"}
command.2 = {"v":2,"t":"bond","zone":"living","members":[{"endpoint":"chorus-0123456789ab","role":"FL"},{"endpoint":"endpoint-b","role":"FR"}]}
input = {"v":2,"t":"speaker_room","speaker":"chorus-0123456789ab","room":"kitchen"}
field = speaker
ends_the_session = 0
