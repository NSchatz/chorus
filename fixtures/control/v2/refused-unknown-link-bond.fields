# Canonical input for the catalog v2 refused-unknown-link-bond vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly refused-unknown-link-bond.json. Nothing of it is applied.
#
# K91: an endpoint that never said its link is not known to be wired, and is
# refused the same way.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = living
command.0 = {"v":2,"t":"attach","zone":"living","endpoint":"endpoint-a","link":"wired"}
command.1 = {"v":1,"t":"attach","zone":"living","endpoint":"endpoint-b"}
input = {"v":2,"t":"bond","zone":"living","members":[{"endpoint":"endpoint-a","role":"FL"},{"endpoint":"endpoint-b","role":"FR"}]}
field = members
ends_the_session = 0
