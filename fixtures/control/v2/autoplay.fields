# Canonical input for the catalog v2 autoplay vector.
#
# Encoding these field values must produce exactly autoplay.json, and decoding
# autoplay.json must recover exactly these field values.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = autoplay
input = endpoint-c/line-1
target = living
enabled = 1
