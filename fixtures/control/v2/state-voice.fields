# Canonical input for the catalog v2 state-voice vector.
#
# (voice, P8) A server that runs one wake-word model, with voice switched on
# in the kitchen: the state lists the model under `wake_words`, last of all,
# for the Home Assistant integration's configuration. No run and no wake event
# is ever in a state.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = state
default_audio = 127.0.0.1:4010
zones = kitchen
wake_words = okay_nabu:Okay Nabu
command.0 = {"v":2,"t":"voice_enabled","zone":"kitchen","enabled":true}
