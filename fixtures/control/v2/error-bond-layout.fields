# Canonical input for the catalog v2 error-bond-layout vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-bond-layout.json. Nothing of it is applied.
#
# Surrounds without a centre is not a layout a set may take.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = living
input = {"v":2,"t":"bond","zone":"living","members":[{"endpoint":"endpoint-a","role":"FL"},{"endpoint":"endpoint-b","role":"FR"},{"endpoint":"endpoint-c","role":"SL"},{"endpoint":"endpoint-d","role":"SR"}]}
field = members
ends_the_session = 0
