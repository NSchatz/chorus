# Canonical input for the catalog v2 room_eq-clear vector.
#
# Encoding these field values must produce exactly room_eq-clear.json, and decoding
# room_eq-clear.json must recover exactly these field values.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.
#
# An empty list clears the room's filters.

message_type = room_eq
zone = living
filters =
