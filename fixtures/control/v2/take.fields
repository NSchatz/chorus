# Canonical input for the catalog v2 take vector.
#
# Encoding these field values must produce exactly take.json, and decoding
# take.json must recover exactly these field values.
#
# Take the room (K78) with no source: the target keeps what its group played.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = take
target = kitchen
