# Canonical input for the catalog v2 error-measure-sweep-volume vector.
#
# `input` is refused, by the decoder or by the room state the lines below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-measure-sweep-volume.json. Nothing of it is applied.
#
# (room correction, ADR 0195) A sweep at a volume outside 0.000 to 1.000.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen
input = {"v":2,"t":"measure_sweep","zone":"kitchen","volume":1.500}
field = volume
ends_the_session = 0
