# Canonical input for the catalog v2 input_label-clear vector.
#
# Encoding these field values must produce exactly input_label-clear.json, and decoding
# input_label-clear.json must recover exactly these field values.
#
# (goal 17) An empty name with the role 'line-in' removes an input's label.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = input_label
input = endpoint-c/line-1
name =
role = line-in
