# Canonical input for the catalog v2 refused-unknown-version vector.
#
# The session refusal a build implementing catalog versions 1 and 2 writes.
# fixtures/control/refused-unknown-version.json is what a v1-only build wrote.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly refused-unknown-version.json. Nothing of it is applied.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = refused
input = {"v":9,"t":"hello"}
zones =
field = v
ends_the_session = 1
offered = 9
implemented = 1,2
