# Canonical input for the catalog v2 error-group-volume-unknown-group vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly error-group-volume-unknown-group.json. Nothing of it is applied.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = kitchen,study
input = {"v":2,"t":"group_volume","group":"downstairs","volume":0.500}
field = group
ends_the_session = 0
