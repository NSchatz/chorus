# Canonical input for the catalog v2 refused-wireless-room-bond vector.
#
# `input` is refused, by the decoder or by the room state the commands below
# built on a server configured with these zones, and encoding the refusal must
# produce exactly refused-wireless-room-bond.json. Nothing of it is applied.
#
# A room declared '--zone <id>=wireless' (ADR 0024's transport) cannot hold a
# bond, whatever its endpoints say.
#
# Format: one "key = value" per line. A line whose first non-space character is
# '#' is a comment; a '#' anywhere else is an ordinary character.

message_type = error
zones = bedroom
transport.bedroom = wireless
command.0 = {"v":2,"t":"attach","zone":"bedroom","endpoint":"endpoint-a","link":"wired"}
command.1 = {"v":2,"t":"attach","zone":"bedroom","endpoint":"endpoint-b","link":"wired"}
input = {"v":2,"t":"bond","zone":"bedroom","members":[{"endpoint":"endpoint-a","role":"FL"},{"endpoint":"endpoint-b","role":"FR"}]}
field = zone
ends_the_session = 0
