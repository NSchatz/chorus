# chorus sync cross-check vector. GENERATED by `make sync-vectors`.
#
# What the Rust sync core did with the scenario named below, exchange by
# exchange. crates/sync/tests/crosscheck_vectors.rs asserts regenerating
# reproduces this file byte for byte; firmware/tests/test_sync.c asserts the
# C endpoint reproduces every value in it. Neither test writes this file.
#
# Doubles are written as the shortest decimal that round-trips, so strtod on
# the other side recovers the identical double and the comparison is exact.

scenario = noiseless-control
source = fixtures/sync/05-noiseless-control.cfg
error_bound_ns = 1000000
steps = 3000
exchanges = 30
hard_resyncs = 0
final_correction_ppm = -0
settled = yes
settle_index = 0
settle_time_ns = 10000000
peak_after_settle_ns = 0
max_abs_error_ns = 0
first_error_ns = 0
last_error_ns = 0

