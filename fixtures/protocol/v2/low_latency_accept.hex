# chorus golden vector: low_latency_accept, protocol v2 message type 0x17.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in low_latency_accept.fields, and recover
# exactly those fields from them (docs/protocol.md, "Low-latency path").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x17, payload length 7 (0x0007), big-endian
17 00 07

# stream_tag = 305419897
12 34 56 79

# status = 0 (accepted)
00

# udp_port = 40002
9C 42
