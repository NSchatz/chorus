# chorus golden vector: hello (an endpoint with the voice role), protocol v2 message type 0x10.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in hello_voice.fields, and recover
# exactly those fields from them (docs/protocol.md, "0x10 hello").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x10, payload length 30 (0x001E), big-endian
10 00 1E

# protocol_version = 2
00 02

# roles = 0x002D: player (bit 0), controller (bit 2), visualizer (bit 3) and voice (bit 5)
00 2D

# name: length 5, then UTF-8 "Study"
05 53 74 75 64 79

# software: length 19, then UTF-8 "chorus-client 0.2.0"
13 63 68 6F 72 75 73 2D 63 6C 69 65 6E 74 20 30
2E 32 2E 30
