# chorus golden vector: coded chunk, protocol v2 message type 0x13.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in coded_chunk.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x13, payload length 19 (0x0013), big-endian
13 00 13

# sequence = 4096
00 00 10 00

# timestamp_ns = 2000000000, server timeline
00 00 00 00 77 35 94 00

# frames = 960
00 00 03 C0

# data: 3 opaque codec bytes (here an Opus TOC byte 0xFC and two bytes; the protocol does not look inside)
FC FF FE
