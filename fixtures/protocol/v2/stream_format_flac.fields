# Canonical input for the stream_format_flac golden vector (protocol v2).
#
# Encoding these field values must produce exactly stream_format_flac.hex, and decoding stream_format_flac.hex
# must recover exactly these field values.
#
# Format: one "key = value" per line, '#' starts a comment. Text is the rest of the line,
# trimmed (so it never starts or ends with a space and never holds '#'). Byte strings are
# hex with no separators. Lists and bit sets are space separated names or numbers.

message_type = stream_format
codec = flac
sample_format = pcm_s16le
sample_rate_hz = 48000
channel_map = FL FR
frames_per_chunk = 4096
codec_config = 100010000000000000000bb802f00000000000000000000000000000000000000000
