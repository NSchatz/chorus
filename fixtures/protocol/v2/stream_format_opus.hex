# chorus golden vector: stream format (Opus, stereo), protocol v2 message type 0x12.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in stream_format_opus.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x12, payload length 34 (0x0022), big-endian
12 00 22

# codec = 3 (opus)
03

# sample_format = 1 (pcm_s16le, what the decoder produces)
01

# sample_rate_hz = 48000 (Opus decodes at 48 kHz)
00 00 BB 80

# channels = 2
02

# channel_map = FL FR
01 02

# frames_per_chunk = 960 (a 20 ms Opus frame)
00 00 03 C0

# codec_config length = 19
00 13

# codec_config: OpusHead (RFC 7845 section 5.1; its own fields are little-endian): version 1, 2 channels, pre-skip 312, input rate 48000, gain 0, mapping family 0
4F 70 75 73 48 65 61 64 01 02 38 01 80 BB 00 00
00 00 00
