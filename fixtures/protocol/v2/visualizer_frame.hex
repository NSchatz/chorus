# chorus golden vector: visualizer frame, protocol v2 message type 0x34.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in visualizer_frame.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x34, payload length 19 (0x0013), big-endian
34 00 13

# timestamp_ns = 4000000000, server timeline
00 00 00 00 EE 6B 28 00

# beat = 255 (a strong beat)
FF

# peak = 210
D2

# band count = 8
08

# bands, low to high
C8 B4 78 5A 3C 1E 0A 00
