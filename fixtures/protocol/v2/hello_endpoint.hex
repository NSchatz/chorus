# chorus golden vector: hello (an endpoint), protocol v2 message type 0x10.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in hello_endpoint.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x10, payload length 32 (0x0020), big-endian
10 00 20

# protocol_version = 2
00 02

# roles = 0x0003: player (bit 0) and metadata (bit 1)
00 03

# name: length 7, then UTF-8 "Kitchen"
07 4B 69 74 63 68 65 6E

# software: length 19, then UTF-8 "chorus-client 0.2.0"
13 63 68 6F 72 75 73 2D 63 6C 69 65 6E 74 20 30
2E 32 2E 30
