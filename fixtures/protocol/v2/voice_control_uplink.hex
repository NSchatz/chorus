# chorus golden vector: voice control, protocol v2 message type 0x3C.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in voice_control_uplink.fields, and recover
# exactly those fields from them (docs/protocol.md, "0x3C voice control").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x3C, payload length 2 (0x0002), big-endian
3C 00 02

# uplink = 1
01

# listening = 0
00
