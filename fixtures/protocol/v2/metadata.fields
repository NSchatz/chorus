# Canonical input for the metadata golden vector (protocol v2).
#
# Encoding these field values must produce exactly metadata.hex, and decoding metadata.hex
# must recover exactly these field values.
#
# Format: one "key = value" per line, '#' starts a comment. Text is the rest of the line,
# trimmed (so it never starts or ends with a space and never holds '#'). Byte strings are
# hex with no separators. Lists and bit sets are space separated names or numbers.

message_type = metadata
playback = playing
position_ms = 61000
duration_ms = 245000
position_at_ns = 3000000000
artwork_id = 7
title = Blue in Green
artist = Miles Davis
album = Kind of Blue
source = UPnP
