# Canonical input for the low_latency_offer_to_endpoint golden vector (protocol v2).
#
# Encoding these field values must produce exactly low_latency_offer_to_endpoint.hex, and decoding low_latency_offer_to_endpoint.hex
# must recover exactly these field values.
#
# Format: one "key = value" per line, '#' starts a comment. Text is the rest of the line,
# trimmed (so it never starts or ends with a space and never holds '#'). Byte strings are
# hex with no separators. Lists and bit sets are space separated names or numbers.
#
# A player's offer: the server sends to the endpoint (its port comes back in the accept),
# column interleave depth 2 for a link that loses in bursts, a 30 ms lead.

message_type = low_latency_offer
direction = to_endpoint
stream_tag = 305419897
key = 202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f
udp_port = 0
chunk_frames = 120
fec_k = 4
fec_depth = 2
latency_ns = 30000000
