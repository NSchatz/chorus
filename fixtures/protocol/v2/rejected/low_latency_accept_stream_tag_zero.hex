# chorus rejection vector: low_latency_accept, protocol v2 message type 0x17, stream_tag out of range.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# reject this frame naming stream_tag (see low_latency_accept_stream_tag_zero.fields).
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x17, payload length 7 (0x0007), big-endian
17 00 07

# stream_tag = 0
00 00 00 00

# status = 0 (accepted)
00

# udp_port = 40002
9C 42
