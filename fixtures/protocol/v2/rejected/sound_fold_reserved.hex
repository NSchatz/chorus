# chorus rejection vector: sound, protocol v2 message type 0x39, fold undefined.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# reject this frame naming fold (see sound_fold_reserved.fields).
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x39, payload length 12 (0x000C), big-endian
39 00 0C

# bass_db = 0 dB
00

# treble_db = 0 dB
00

# flags = 0x01 (loudness)
01

# role = 1 (FL)
01

# sub_present = 0
00

# crossover_hz = 80
00 50

# sub_level_cdb = 0 (0.00 dB)
00 00

# eq_count = 0
00

# the theater block (goal 13): tv_upmix = 0 (off)
00

# fold = 0x05 (centre and reserved bit 0x04)
05
