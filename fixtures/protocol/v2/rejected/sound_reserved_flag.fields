# Canonical input for the sound_reserved_flag rejection vector (protocol v2).
#
# A REJECTION vector: these fields are not a message the format accepts, so an encoder must
# refuse them (emitting nothing) naming `rejected_field`, and a decoder must reject
# sound_reserved_flag.hex as that field, consuming the whole frame and carrying on with the
# next one (docs/protocol.md, "Decoder behaviour", step 5).
#
# Format: as the vectors one directory up, plus `rejected_field` (the field named) and
# `problem` (what is wrong with it).
#
# A flag bit this version does not define (bit 5).

message_type = sound
bass_db = 0
treble_db = 0
flags = loudness room_eq
flags_reserved = 32
role = 0
sub_present = 0
crossover_hz = 80
sub_level_cdb = 0
rejected_field = flags
problem = undefined
