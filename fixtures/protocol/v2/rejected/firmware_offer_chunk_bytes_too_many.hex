# chorus REJECTION vector: firmware offer, protocol v2 message type 0x18.
#
# Committed, and never written by a test. A well-formed frame whose value the format does not
# accept: any implementation of chorus protocol v2 must reject it naming `chunk_bytes` (out of range),
# consume the whole frame and carry on with the next one, and must refuse to encode the fields in
# firmware_offer_chunk_bytes_too_many.fields (docs/protocol.md, "Decoder behaviour", step 5).
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x18, payload length 63 (0x003F), big-endian
18 00 3F

# transfer = 7
00 00 00 07

# size = 1437696 bytes
00 15 F0 00

# sha256, the digest of the whole image
77 1A F9 13 04 D4 80 62 A3 D0 68 76 EB 34 7D 88
69 C6 AE A8 58 69 C0 17 35 A5 99 48 41 A1 F9 C8

# chunk_bytes = 4097
10 01

# version length = 5
05

# version = "0.3.0"
30 2E 33 2E 30

# board length = 14
0E

# board = "brick-s3-wired"
62 72 69 63 6B 2D 73 33 2D 77 69 72 65 64
