# chorus golden vector: source offer, protocol v2 message type 0x36.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in source_offer.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x36, payload length 13 (0x000D), big-endian
36 00 0D

# source_id = 1
01

# kind = 1 (line_in)
01

# signal = 1 (present)
01

# name: length 9, then UTF-8
09 54 75 72 6E 74 61 62 6C 65
