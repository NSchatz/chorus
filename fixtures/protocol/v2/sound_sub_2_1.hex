# chorus golden vector: sound, protocol v2 message type 0x39.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in sound_sub_2_1.fields, and recover
# exactly those fields from them (docs/protocol.md, "0x39 sound").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x39, payload length 16 (0x0010), big-endian
39 00 10

# bass_db = 3 dB
03

# treble_db = -2 dB
FE

# flags = 0x19 (loudness room_eq sub_inverted)
19

# role = 4 (LFE)
04

# sub_present = 1
01

# crossover_hz = 100
00 64

# sub_level_cdb = -350 (-3.50 dB)
FE A2

# eq_count = 1
01

# filter 0: freq_hz = 42, gain_cdb = -600 (-6.00 dB), q_milli = 4500 (Q 4.500)
00 2A FD A8 11 94
