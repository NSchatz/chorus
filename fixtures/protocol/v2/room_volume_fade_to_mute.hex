# chorus golden vector: room volume, protocol v2 message type 0x38.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in room_volume_fade_to_mute.fields, and recover
# exactly those fields from them (docs/protocol.md, "0x38 room volume").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x38, payload length 6 (0x0006), big-endian
38 00 06

# gain = 0 thousandths
00 00

# limit = 1000 thousandths
03 E8

# ramp_ms = 30000
75 30
