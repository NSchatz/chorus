# chorus golden vector: source control, protocol v2 message type 0x37.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in source_control.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x37, payload length 3 (0x0003), big-endian
37 00 03

# source_id = 1
01

# action = 1 (start)
01

# codec = 2 (flac)
02
