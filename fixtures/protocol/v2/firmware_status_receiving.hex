# chorus golden vector: firmware status, protocol v2 message type 0x1A.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in firmware_status_receiving.fields, and recover
# exactly those fields from them (docs/protocol.md, "0x1A firmware status").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x1A, payload length 38 (0x0026), big-endian
1A 00 26

# transfer = 7
00 00 00 07

# state = 1 (receiving)
01

# reason = 0 (none)
00

# received = 65536 bytes
00 01 00 00

# version length = 5
05

# version = "0.2.0"
30 2E 32 2E 30

# board length = 14
0E

# board = "brick-s3-wired"
62 72 69 63 6B 2D 73 33 2D 77 69 72 65 64

# slot = 0
00

# image_version length = 5
05

# image_version = "0.3.0"
30 2E 33 2E 30
