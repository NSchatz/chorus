# chorus golden vector: metadata, protocol v2 message type 0x30.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in metadata.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x30, payload length 69 (0x0045), big-endian
30 00 45

# playback = 1 (playing)
01

# position_ms = 61000
00 00 EE 48

# duration_ms = 245000
00 03 BD 08

# position_at_ns = 3000000000, server timeline
00 00 00 00 B2 D0 5E 00

# artwork_id = 7
00 00 00 07

# title: length 13, then UTF-8
00 0D 42 6C 75 65 20 69 6E 20 47 72 65 65 6E

# artist: length 11, then UTF-8
00 0B 4D 69 6C 65 73 20 44 61 76 69 73

# album: length 12, then UTF-8
00 0C 4B 69 6E 64 20 6F 66 20 42 6C 75 65

# source: length 4, then UTF-8
00 04 55 50 6E 50
