# chorus golden vector: stream format (PCM, 5.1), protocol v2 message type 0x12.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in stream_format_pcm.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x12, payload length 19 (0x0013), big-endian
12 00 13

# codec = 1 (pcm)
01

# sample_format = 2 (pcm_s24le)
02

# sample_rate_hz = 48000
00 00 BB 80

# channels = 6
06

# channel_map = FL FR FC LFE BL BR (the WAVE_FORMAT_EXTENSIBLE 5.1 order)
01 02 03 04 05 06

# frames_per_chunk = 960 (20 ms at 48 kHz)
00 00 03 C0

# codec_config length = 0: PCM carries no codec setup
00 00
