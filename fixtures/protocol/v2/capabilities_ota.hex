# chorus golden vector: capabilities, protocol v2 message type 0x11.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in capabilities_ota.fields, and recover
# exactly those fields from them (docs/protocol.md, "Firmware update").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x11, payload length 22 (0x0016), big-endian
11 00 16

# codecs = 0x07: pcm (bit 0), flac (bit 1), opus (bit 2)
07

# sample_formats = 0x03: pcm_s16le (bit 0), pcm_s24le (bit 1)
03

# max_channels = 2
02

# rate count = 2
02

# sample_rates_hz[0] = 44100
00 00 AC 44

# sample_rates_hz[1] = 48000
00 00 BB 80

# buffer_ms = 300
01 2C

# intrinsic_latency_ns = 0
00 00 00 00

# led_count = 0
00 00

# visualizer_bands = 0
00

# features = 0x02: ota (bit 1), the trailing byte; absent reads as 0
02
