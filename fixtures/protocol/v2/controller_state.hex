# chorus golden vector: controller state, protocol v2 message type 0x33.
#
# Committed, and never written by a test. Any implementation of chorus protocol v2 must
# produce these exact bytes from the canonical input in controller_state.fields, and recover
# exactly those fields from them (docs/protocol.md, "Version 2").
#
# Format: whitespace separated hex bytes, '#' starts a comment.

# frame header: type 0x33, payload length 14 (0x000E), big-endian
33 00 0E

# volume = 35
23

# muted = 0
00

# playback = 2 (paused)
02

# group: length 10, then UTF-8
0A 44 6F 77 6E 73 74 61 69 72 73
