# Canonical input for the firmware_status golden vector (protocol v2).
#
# Encoding these field values must produce exactly firmware_status.hex, and decoding firmware_status.hex
# must recover exactly these field values.
#
# Format: one "key = value" per line, '#' starts a comment. Text is the rest of the line,
# trimmed (so it never starts or ends with a space and never holds '#'). Byte strings are
# hex with no separators. Lists and bit sets are space separated names or numbers.
#
# What every session opens with when nothing is in progress: a confirmed 0.2.0 running from
# slot 0.

message_type = firmware_status
transfer = 0
state = idle
reason = none
received = 0
version = 0.2.0
board = brick-s3-wired
slot = 0
image_version =
