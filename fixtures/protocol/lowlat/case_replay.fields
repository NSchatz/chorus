# chorus low-latency vector: the case case_replay.
#
# Committed, and never written by a test. Open the datagrams of stream_k4_d1.fields
# listed in `deliver`, in that order (an index twice is a repeat), each with the
# stream's key and the receiver's stream_tag (the stream's unless named here), XOR
# `tamper` (datagram, byte offset, mask) into one first, push what opens through the
# FEC decoder, then finish the stream after its `chunks`. The chunks handed on, the
# ones rebuilt and every count below must be exactly these.
#
# Datagrams 1 and 6 delivered twice, the repeat of 1 after group 1 began: the
# replay window drops both repeats before the FEC sees them.

stream = stream_k4_d1
deliver = 0 1 2 3 4 5 1 6 6 7 8 9
expect_delivered = 0 1 2 3 4 5 6 7
expect_recovered = 
expect_opened = 10
expect_malformed = 0
expect_wrong_stream_tag = 0
expect_replayed = 2
expect_auth_failed = 0
expect_unrecoverable = 0
expect_duplicate = 0
