# Canonical input for the stream_end golden vector.
#
# Encoding these field values must produce exactly stream_end.hex, and decoding
# stream_end.hex must recover exactly these field values.
#
# Format: one "key = value" per line, '#' starts a comment.

message_type = stream_end

# The final chunk of the stream was sequence 41.
final_sequence = 41
# Its presentation timestamp was 820000000 ns and the chunk lasted 20 ms, so
# the stream stops being audible at 840000000 ns on the server timeline.
end_timestamp_ns = 840000000
