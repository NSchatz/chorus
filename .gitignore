# Build output.
/target

# The endpoint's host build and its image build. Both are outputs; every input
# they read is committed.
/firmware/build
/firmware/sdkconfig
/firmware/sdkconfig.old

# The rendered UI grader's driver, which is a DEV dependency and is installed
