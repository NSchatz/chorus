# Build output.
/target

# The endpoint's host build and its image build. Both are outputs; every input
# they read is committed.
/firmware/build
/firmware/sdkconfig
/firmware/sdkconfig.old
# The component manager's download of firmware/main/idf_component.yml's pins;
# firmware/dependencies.lock, which pins them by hash, is committed.
/firmware/managed_components


# Release artifacts (tools/release.sh); attached to GitHub releases, never committed.
/dist

# Python byte code, should a tool script be imported or compiled.
__pycache__/

# Core dumps (W62): a file named core or core.<pid>, never a directory named core.
core
!core/
core.[0-9]*
