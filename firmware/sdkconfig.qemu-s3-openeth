# The emulator board's own ESP-IDF options, laid over sdkconfig.defaults by
# tools/firmware-image.sh for the qemu-s3-openeth profile only (goal 14,
# docs/decisions/0109-*). Line numbers are in the pinned ESP-IDF v6.1, read
# 2026-10-02.
#
# Only what the emulator forces. The partition table, the flash size and every
# option of the firmware update are sdkconfig.defaults', so the image the
# emulator boots has the layout a speaker's has.

# The emulator's Ethernet controller: "OpenCores Ethernet MAC driver can be
# used when an ESP-IDF application is executed in QEMU. This driver is not
# supported when running on a real chip." (components/esp_eth/Kconfig:149-157;
# it defaults to n.) firmware/main/esp_link.c binds it for a profile whose
# link is `emulated`, and refuses by name in an image built without it.
CONFIG_ETH_USE_OPENETH=y

# The octal PSRAM stays as sdkconfig.defaults has it: the emulator emulates an
# octal part (tools/qemu/lib.sh starts it with one), and the endpoint needs it.
# Built without PSRAM, the image stopped at its first step in the emulator,
# "no memory to read firmware/config/endpoint.conf and the embedded board
# profile": the configuration reader takes one 128 KiB block for its two
# tables, the internal heap's largest free block was 90 KiB, and on a speaker
# malloc() places a block that large in PSRAM (the generated sdkconfig has
# CONFIG_SPIRAM_USE_MALLOC=y; docs/decisions/0109-*).
