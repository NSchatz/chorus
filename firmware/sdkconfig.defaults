# The endpoint's ESP-IDF defaults.
#
# Only what this phase asserts. Everything a later phase owns is left at
# ESP-IDF's own default and named here as belonging to that phase, so a reader
# can see what was decided and what was deliberately not.

CONFIG_IDF_TARGET="esp32s3"

# Octal PSRAM, which is why firmware/config/endpoint.conf declares
# board_octal_psram = yes and why the pin-map check extends its reserved range
# to GPIO33 to GPIO37.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# DMA descriptors stay out of external RAM. The carried ESP-IDF external-RAM
# guide: "DMA transaction descriptors cannot be placed in PSRAM."
# firmware/check/endpoint_scan.c fails the suite if any PSRAM placement appears
# in the endpoint tree, and this keeps the allocator from putting one there by
# default.
CONFIG_SPIRAM_USE_MALLOC=n

# The v2 session's crypto (docs/decisions/0039-the-v2-key-exchange.md):
# Noise_XX_25519_ChaChaPoly_SHA256 through Mbed TLS 4's PSA Crypto API, which
# ESP-IDF v6 ships (docs.espressif.com/projects/esp-idf/en/v6.1/esp32s3/
# migration-guides/release-6.x/6.0/security.html, read 2026-09-30).
# components/mbedtls/port/include/mbedtls/esp_config.h in v6.1 maps each option
# onto the PSA_WANT_ symbol the endpoint's calls need: CHACHA20_C to
# PSA_WANT_KEY_TYPE_CHACHA20 (:1984), CHACHAPOLY_C to
# PSA_WANT_ALG_CHACHA20_POLY1305 (:1999), ECP_DP_CURVE25519_ENABLED to PSA_WANT_ECC_MONTGOMERY_255 (:567), ECDH_C
# to PSA_WANT_ALG_ECDH (:2088) and SHA256_C to PSA_WANT_ALG_SHA_256 (:2631).
# ChaCha20 and ChaCha20-Poly1305 default to n in components/mbedtls/Kconfig
# (:1625-1636); the other three default to y and are stated here so that a
# change of default cannot remove them silently.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_SHA256_C=y

# The wired link (goal 8, P1): ESP-IDF's SPI Ethernet support, which the pinned
# espressif/w5500 component (firmware/main/idf_component.yml) builds on. It
# defaults to y in components/esp_eth/Kconfig of the pinned v6.1 ("ESP-IDF can
# also support SPI-Ethernet. Actual chip drivers are available as components in
# Component Registry", read 2026-09-30), and is stated so a change of default
# cannot remove it silently.
CONFIG_ETH_USE_SPI_ETHERNET=y

# NOT SET HERE, deliberately:
#
# - Wi-Fi power save. chorus#WIFI-7 owns the wireless tier, asserts the mode by
#   name and measures the jitter both ways. This phase asserts nothing about
#   which link the endpoint uses, so it sets nothing.
# - Anti-rollback. It burns an eFuse (the secure version), and guardrail 2
#   forbids that on development hardware; see the firmware update block below,
#   which states it off, and the image guard, which refuses it on.
# - Secure Boot and Flash Encryption. Both burn eFuses, an eFuse bit set to 1
#   "cannot be reverted back to 0", and guardrail 2 forbids that on development
#   hardware outright.

# The firmware update's layout (goal 14, docs/decisions/OTAADR-*): two app slots of
# equal size and the otadata that selects one, no factory app (firmware/partitions.csv). Two
# 3 MiB slots do not fit ESP-IDF's default 2 MB of flash, so the flash size is stated: 8 MB,
# which is what both board profiles declare (board_flash_size_mb) and is ASSUMED for the
# owner's board until the item "Your ESP32-S3 boards: module markings and a read-only chip
# report" says. The 1.5 MB single-app table of goal 6 (docs/decisions/0044-*) is retired.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Rollback: the bootloader boots a newly selected image ONCE on trial and goes back to the
# previous one unless the app confirmed it (CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE,
# components/bootloader/Kconfig.projbuild in the pinned v6.1; the rule itself is
# components/bootloader_support/src/bootloader_utility.c:393-401 and :443-449, read
# 2026-10-02). firmware/src/ota.c decides when to confirm; firmware/main/esp_ota.c is the one
# unit that calls ESP-IDF's OTA functions.
#
# Anti-rollback is NOT rollback: it burns the image's secure version into an eFuse, which
# guardrail 2 forbids. It is stated off here, refused by the source scan
# (firmware/check/efuse-kconfig.list) and asserted off in every built image by
# tools/firmware-image-guard.sh.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set

# app_main's own stack (goal 8). Its large objects are static and the session and
# playout writer run in their own tasks (firmware/main/app_main.c), but the bring-up
# calls it makes (the configuration parse, the amplifier sequencer, the radio) still
# run on it, and ESP-IDF's 3584-byte default (components/esp_system/Kconfig,
# ESP_MAIN_TASK_STACK_SIZE, pinned v6.1, read 2026-09-30) leaves no headroom that
# anyone has measured. The stack is freed when app_main returns ("If app_main()
# returns then this task is deleted and its stack memory is freed"). ASSUMED until
# the bench reads the high-water mark.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
