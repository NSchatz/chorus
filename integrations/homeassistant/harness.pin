# The Home Assistant test harness pin, in the one place the checks read
# (tools/conventions/check-ha-integration.sh, tools/ha-hassfest.sh).
#
# The rule: this pin moves when the homelab's Home Assistant pin moves, and
# only then. The homelab runs the image tag recorded below
# (home-automation/homeassistant/docker-compose.yml at homelab commit 025409f);
# the harness release is the one whose `homeassistant==` requirement is that
# version. docs/home-assistant.md, "Moving the pin", is the procedure.
#
# Sources, read 2026-10-19:
#   https://pypi.org/pypi/pytest-homeassistant-custom-component/0.13.373/json
#     (requires homeassistant==2026.10.2; MIT; the wheel's sha256 below)
#   https://github.com/home-assistant/core/tree/2026.10.2 (the tag's commit below,
#     from `git ls-remote`; pyproject.toml requires Python >= 3.14.2)
#
# Format: one "key = value" per line.
homeassistant = 2026.10.2
homelab-commit = 025409f
harness = pytest-homeassistant-custom-component
harness-version = 0.13.373
harness-wheel-sha256 = bdd22816780122def0451564c46b536c9889c14c04da98782ea5db4a40994dab
core-tag = 2026.10.2
core-commit = 8d7fd8b68677c2585be36ec86043308f403875b8
python = 3.14.8
